<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcceptAFKServer.Presentation.Pages.ConfigurationPage"
             BackgroundColor="#CC9BC4E9">
       <Border Padding="16"
               StrokeThickness="0.8"
               Stroke="#B91786E7"
               HorizontalOptions="Fill"
               Background="#A659A3E4"
               Margin="20">
              <VerticalStackLayout BackgroundColor="#A659A3E4"
                                   Spacing="20"
                                   Padding="8"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill">
                     <!-- Título -->
                     <Label
                            Text="Configurações"
                            FontSize="22"
                            HorizontalOptions="Start"/>
                     <!-- Campo Wi-Fi + Botão Recarregar -->
                     <Grid ColumnDefinitions="*,Auto">
                            <!-- Picker de Wi-Fi -->
                            <Picker
                                   Grid.Column="0"
                                   x:Name="WifiPicker"
                                   Title="Selecione uma rede Wi-Fi"
                                   ItemsSource="{Binding WifiList}"
                                   SelectedItem="{Binding SelectedWifi}"
                                   HorizontalOptions="FillAndExpand"/>

                            <!-- Botão Recarregar -->
                            <ImageButton
                                   Grid.Column="1"
                                   x:Name="RefreshButton"
                                   Source="refresh.png"
                                   HeightRequest="60"
                                   WidthRequest="60"
                                   BackgroundColor="Transparent"
                                   Clicked="OnReloadWifiClicked"/>
                     </Grid>
              </VerticalStackLayout>
       </Border>
</ContentView>

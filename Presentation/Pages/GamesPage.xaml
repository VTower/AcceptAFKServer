<?xml version="1.0" encoding="utf-8"?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcceptAFKServer.Presentation.Pages.GamesPage">

<!-- TODO: Adicionar coleta de index para quale está no meio. -->
<ScrollView Orientation="Vertical">
    <VerticalStackLayout
        Spacing="20"
        Padding="10"
        BindableLayout.ItemsSource="{Binding Games}">
        <BindableLayout.ItemTemplate>
            <DataTemplate>
                <Image
                    Source="{Binding}"
                    WidthRequest="600"
                    HeightRequest="400"/>
            </DataTemplate>
        </BindableLayout.ItemTemplate>

    </VerticalStackLayout>
</ScrollView>

</ContentView>